# Copy to tofu/.env and fill in the values from Vaultwarden.
# tofu/.env is in .gitignore and stays on your machine.
OPENNEBULA_ENDPOINT=https://<opennebula>:2633/RPC2
OPENNEBULA_USERNAME=<benutzer>
# Password or, better, a login token: oneuser token-create --time <seconds> --group <group>
OPENNEBULA_PASSWORD=<passwort oder token>

# At least 16 characters
TOFU_STATE_PASSPHRASE=<passphrase>
