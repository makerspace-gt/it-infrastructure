# Writes the Ansible inventory from the VMs above
locals {
  inventory_groups = distinct(flatten([for vm in local.vms : vm.groups]))

  inventory = {
    all = {
      children = {
        for group in local.inventory_groups : group => {
          hosts = {
            for name, vm in local.vms : name => {
              ansible_host = opennebula_virtual_machine.vm[name].nic[0].computed_ip
            } if contains(vm.groups, group)
          }
        }
      }
    }
  }
}

resource "local_file" "inventory" {
  filename        = "${path.module}/../ansible/inventory/hosts.yml"
  content         = "# Generated by OpenTofu from tofu/vms.tf, do not edit\n${yamlencode(local.inventory)}"
  file_permission = "0644"
}
